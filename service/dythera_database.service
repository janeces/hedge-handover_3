[Unit]
Description=Run the Dythera database
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/hedge_device_io/env.conf
ExecStartPre=/usr/local/hedge_device_io/wait_for_valid_time.sh
ExecStartPre=/bin/sleep 60
ExecStart=/usr/local/hedge_device_io/run_dythera_database.sh
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target